#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <input/processors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 3

// AML クリックしたときにタイムアウトを延長
//解除キー廃止に伴い時間変更10000→400

&mkp_input_listener { input-processors = <&zip_temp_layer MOUSE 400>; };

/ {
    combos {
        compatible = "zmk,combos";

        kakko_left {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <2 3>;
            layers = <0 1>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
        };

        kakko_right {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <6 7>;
            layers = <0 1>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
        };

        daikakko_left {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <12 13>;
            layers = <0 1>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
        };

        daikakko_right {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <16 17>;
            layers = <1 0>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
        };

        chukakko_left {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <22 23>;
            layers = <0 1>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
        };

        chukakko_right {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <26 27>;
            layers = <0 1>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <13 14>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
            layers = <0 1>;
        };

        semicolon {
            bindings = <&kp SEMICOLON>;
            key-positions = <15 16>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
            layers = <0 1>;
        };

        doublequote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <3 4>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
            layers = <0 1>;
        };

        quote {
            bindings = <&kp SQT>;
            key-positions = <6 5>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
            layers = <0 1>;
        };

        at {
            bindings = <&kp RS(NUMBER_2)>;
            key-positions = <12 13>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
            layers = <5>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 7>,
                <&macro_press>,
                <&kp LEFT_WIN &kp LEFT_SHIFT &kp S>,
                <&macro_release>,
                <&kp LEFT_WIN &kp LEFT_SHIFT &kp S>;

            label = "SCREENSHOT";
        };

        EN_to_L0: EN_to_L0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LANG2>;
            label = "EN_TO_L0";
        };

        JP_to_L1: JP_to_L1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &kp LANGUAGE_1>;
            label = "JP_TO_L1";
        };

        kakko: kakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT>;
            label = "KAKKO";
        };

        doublequote: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp DOUBLE_QUOTES &kp DOUBLE_QUOTES &kp LEFT>;
            label = "NEW_MACRO";
        };

        kagikakko: kagikakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_1 &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp SPACE &kp ENTER &kp LEFT>;
            label = "KAGIKAKKO";
        };

        sss: sss {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp RIGHT_CONTROL>,
                <&macro_press>,
                <&macro_wait_time 20>,
                <&kp K_SCROLL_UP>,
                <&macro_tap>,
                <&macro_wait_time 20>,
                <&kp RIGHT_CONTROL>,
                <&macro_release>,
                <&macro_wait_time 20>;

            label = "SSS";
        };

        ddd: ddd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp RIGHT_CONTROL>,
                <&macro_press>,
                <&macro_wait_time 20>,
                <&kp Z>,
                <&macro_tap>,
                <&macro_wait_time 20>,
                <&kp RIGHT_CONTROL>,
                <&macro_release>,
                <&macro_wait_time 20>;

            label = "DDD";
        };

        lng2_under_l0: lng2_under_l0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp RS(MINUS) &to 0>;
            label = "LNG2_UNDER_L0";
        };

        lng2_at_l0: lng2_at_l0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp RS(NUMBER_2) &to 0>;
            label = "LNG2_AT_L0";
        };

        lng2_under: lng2_under {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp RS(MINUS) &to 0>;
            label = "LNG2_UNDER";
        };

        lng2_at: lng2_at {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp RS(NUMBER_2) &to 0>;
            label = "LNG2_AT";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };

        // Kyemap Editor用

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };

        vol_up_down: vol_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            bindings = <&kp C_VOL_DN>, <&kp C_VOL_UP>;
        };

        // DYA Studio用

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_DN>;
            ccw-binding = <&kp C_VOL_UP>;
        };

        // 引き継ぎ

        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        // ロータリーエンコーダー：縦スクロール（Smooth Scrolling向け）

        mouse_scrl_v: mouse_scroll_vertical {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            bindings = <&msc MOVE_Y(-900)>, <&msc MOVE_Y(900)>;
        };

        // ロータリーエンコーダー：横スクロール（Smooth Scrolling向け）

        mouse_scrl_h: mouse_scroll_horizontal {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            bindings = <&msc MOVE_X(900)>, <&msc MOVE_X(-900)>;
        };

        volume_up_down: volume_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            label = "VOLUME_UP_DOWN";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOLUME_UP>, <&kp C_VOLUME_DOWN>;

            tap-ms = <20>;
        };

        mt_L0EN: mt_L0EN {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_L0EN";
            bindings = <&kp>, <&EN_to_L0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mt_L1JP: mt_L1JP {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_L1JP";
            bindings = <&kp>, <&JP_to_L1>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mt_qs_on: mt_qs_on {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_QS_ON";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
        };

        lt_qs_on: lt_qs_on {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_QS_ON";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
        };

        rotate_test: rotate_test {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE_TEST";
            #sensor-binding-cells = <2>;
            bindings = <&sss>, <&ddd>;

            tap-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                  &kp W                &lt_qs_on 7 E            &lt_qs_on 5 R      &lt_qs_on 4 T                                              &kp Y              &kp U                  &kp I      &kp O          &lt_qs_on 4 P
&kp A                  &kp S                &kp D                    &lt_qs_on 8 F      &kp G                                                      &kp H              &lt_qs_on 8 J          &kp K      &kp L          &lt_qs_on 9 MINUS
&mt_qs_on RC(Z) Z      &mt_qs_on RC(C) X    &mt_qs_on RC(X) C        &mt_qs_on RC(V) V  &mt_qs_on RC(Y) B                                          &kp N              &kp M                  &kp COMMA  &kp PERIOD     &lt_qs_on 8 SLASH
&mt RIGHT_CONTROL ESC  &mt RIGHT_SHIFT TAB  &mt RIGHT_ALT RIGHT_GUI  &EN_to_L0          &mt_qs_on RIGHT_SHIFT SPACE  &mt_L1JP RIGHT_CONTROL 0      &lt_qs_on 7 ENTER  &lt_qs_on 5 BACKSPACE  &mo 10     &kp RIGHT_GUI  &mt_qs_on RIGHT_ALT BACKSLASH
            >;

            sensor-bindings = <&mouse_scrl_v>, <&rsr_trans>;
        };

        OHNISHI {
            bindings = <
&kp Q              &kp L              &lt_qs_on 7 U      &lt_qs_on 5 COMMA  &lt_qs_on 4 DOT                    &kp F   &kp W          &kp R   &kp Y   &lt_qs_on 4 P
&kp E              &kp I              &kp A              &lt_qs_on 8 O      &kp MINUS                          &kp K   &lt_qs_on 8 T  &kp N   &kp S   &lt_qs_on 9 H
&mt_qs_on RC(Z) Z  &mt_qs_on RC(C) X  &mt_qs_on RC(X) C  &mt_qs_on RC(V) V  &mt_qs_on RC(Y) SLASH              &kp G   &kp D          &kp M   &kp J   &lt_qs_on 8 B
&trans             &trans             &trans             &trans             &trans                 &trans      &trans  &trans         &trans  &trans  &trans
            >;

            sensor-bindings = <&mouse_scrl_v>, <&rsr_trans>;
        };

        default_not_ohnishi {
            bindings = <
&kp Q                        &kp W                      &lt_qs_on 7 E                  &lt_qs_on 6 R      &lt_qs_on 4 T                                                   &kp Y              &kp U                  &kp I      &kp O          &lt_qs_on 4 P
&kp A                        &kp S                      &kp D                          &lt_qs_on 8 F      &kp G                                                           &kp H              &lt_qs_on 8 J          &kp K      &kp L          &lt_qs_on 9 MINUS
&mt_qs_on RC(Z) Z            &mt_qs_on RC(C) X          &mt_qs_on RC(X) C              &mt_qs_on RC(V) V  &mt_qs_on RC(Y) B                                               &kp N              &kp M                  &kp COMMA  &kp PERIOD     &lt_qs_on 8 SLASH
&mt_qs_on RIGHT_CONTROL ESC  &mt_qs_on RIGHT_SHIFT TAB  &mt_qs_on RIGHT_ALT RIGHT_GUI  &kp LANGUAGE_2     &mt_qs_on RIGHT_SHIFT SPACE  &mt_qs_on RIGHT_CONTROL LANG1      &lt_qs_on 7 ENTER  &lt_qs_on 6 BACKSPACE  &mo 10     &kp RIGHT_GUI  &mt_qs_on RIGHT_ALT BACKSLASH
            >;

            sensor-bindings = <&mouse_scrl_v>, <&rsr_trans>;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                  &trans  &trans    &trans           &mo 8              &trans
&trans  &trans  &trans  &trans  &trans                                  &trans  &mkp MB1  &mkp MB2         &mo 7              &trans
&trans  &trans  &trans  &trans  &trans                                  &trans  &trans    &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &trans
&trans  &trans  &trans  &trans  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL      &trans  &trans    &trans           &trans             &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>, <&rsr_trans>;
        };

        slow {
            bindings = <
&trans  &trans  &trans  &trans  &trans              &trans  &trans        &kp RG(UP)    &trans         &trans
&trans  &trans  &trans  &trans  &trans              &trans  &kp RG(LEFT)  &kp RG(DOWN)  &kp RG(RIGHT)  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans        &trans        &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans         &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>, <&rsr_trans>;
        };

        num_func {
            bindings = <
&kp F9  &kp F10  &kp F11  &kp F12      &kp RC(F)                                     &kp PLUS   &kp N7  &kp N8  &kp N9       &kp MINUS
&kp F5  &kp F6   &kp F7   &kp F8       &kp RG(V)                                     &kp DOT    &kp N4  &kp N5  &kp N6       &kp N0
&kp F1  &kp F2   &kp F3   &kp F4       &kp RS(RG(S))                                 &kp ASTRK  &kp N1  &kp N2  &kp N3       &kp FSLH
&trans  &trans   &trans   &lng2_at_l0  &lng2_under_l0  &mt_L0EN RIGHT_CONTROL 0      &trans     &trans  &trans  &kp PERCENT  &kp EQUAL
            >;

            sensor-bindings = <&mouse_scrl_h>, <&rsr_trans>;
        };

        num_not_ohnishi {
            bindings = <
&kp F9  &kp F10  &kp F11  &kp F12   &kp RC(F)                                        &kp PLUS   &kp N7  &kp N8  &kp N9       &kp MINUS
&kp F5  &kp F6   &kp F7   &kp F8    &kp RG(V)                                        &kp DOT    &kp N4  &kp N5  &kp N6       &kp N0
&kp F1  &kp F2   &kp F3   &kp F4    &kp RS(RG(S))                                    &kp ASTRK  &kp N1  &kp N2  &kp N3       &kp FSLH
&trans  &trans   &trans   &lng2_at  &lng2_under    &mt RIGHT_CONTROL LANGUAGE_2      &trans     &trans  &trans  &kp PERCENT  &kp EQUAL
            >;

            sensor-bindings = <&mouse_scrl_h>, <&rsr_trans>;
        };

        symbol_scroll_vrt {
            bindings = <
&kp ESC  &kp LC(Y)  &trans  &kp LBKT       &kp RBKT                       &kakko        &kp AMPERSAND    &kp DOLLAR    &kp TILDE  &trans
&kp TAB  &trans     &trans  &kp SEMICOLON  &kp COLON                      &doublequote  &kp AT_SIGN      &kp HASH      &kp CARET  &trans
&trans   &trans     &trans  &kp SQT        &kp DOUBLE_QUOTES              &kagikakko    &kp EXCLAMATION  &kp QUESTION  &kp TILDE  &trans
&trans   &trans     &trans  &trans         &trans             &trans      &trans        &trans           &trans        &trans     &trans
            >;

            sensor-bindings = <&re_kp F17 F18>, <&rsr_trans>;
        };

        ctrl_office_scroll_hrz {
            bindings = <
&kp RA(Q)  &kp RA(W)  &kp RA(E)  &kp RA(R)  &trans                         &trans         &kp HOME    &kp UP     &kp END    &trans
&kp RA(A)  &kp RA(S)  &kp RA(D)  &kp RA(F)  &trans                         &kp RC(Z)      &kp LEFT    &kp DOWN   &kp RIGHT  &trans
&kp RA(Z)  &kp RA(X)  &kp RA(C)  &kp RA(V)  &trans                         &kp RC(Y)      &kp RC(C)   &kp RC(X)  &kp RC(V)  &trans
&trans     &trans     &trans     &kp ENTER  &kp BACKSPACE  &kp DELETE      &kp RIGHT_GUI  &kp DELETE  &trans     &trans     &trans
            >;

            sensor-bindings = <&re_kp RC(Z) RC(Y)>;
        };

        browse {
            bindings = <
&trans  &trans  &trans  &trans            &trans              &kp RC(T)      &kp F15            &kp F16        &trans  &trans
&trans  &trans  &trans  &trans            &trans              &kp RC(W)      &kp RS(RC(TAB))    &kp RC(TAB)    &kp F5  &trans
&trans  &trans  &trans  &trans            &trans              &kp RS(RC(T))  &kp RA(LEFT)       &kp RA(RIGHT)  &trans  &trans
&trans  &trans  &trans  &kp RC(RG(LEFT))  &trans  &trans      &kp RG(TAB)    &kp RC(RG(RIGHT))  &trans         &trans  &trans
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        wireless {
            bindings = <
&trans  &trans  &trans  &trans  &trans                   &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans                   &to 0         &to 2           &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans                   &trans        &trans          &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &bootloader      &bootloader   &studio_unlock  &trans        &trans        &bt BT_CLR_ALL
            >;
        };
    };
};
